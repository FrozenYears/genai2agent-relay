# The first-hop jollyxenon/shanghaitech-genai2api service.
UPSTREAM_BASE_URL=http://127.0.0.1:31100

# Optional. Set this only when the first-hop service enables API_KEY.
# UPSTREAM_API_KEY=replace-with-upstream-key

# Optional. When set, downstream clients must use this key.
# RELAY_API_KEY=replace-with-relay-key

HOST=127.0.0.1
PORT=31110
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=1800
UPSTREAM_ACTION_RETRIES=2
MAX_ACTION_BYTES=1048576
