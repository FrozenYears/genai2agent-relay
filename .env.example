# 当前只使用本地第一跳；不要改为学校独立 API 或跳过网页链路。
UPSTREAM_BASE_URL=http://127.0.0.1:31100
# native 保留结构化工具和历史；纯文本后端必须显式选择 text，不自动降级。
UPSTREAM_TOOL_MODE=native

# 可选：对应第一跳本地代理的 API Key，不是学校独立 API Key。
# UPSTREAM_API_KEY=replace-with-upstream-key

# 可选：设置后下游客户端必须使用此 Key。
# RELAY_API_KEY=replace-with-relay-key

HOST=127.0.0.1
PORT=31110
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=1800
# 仅 text 模式、尚未交付内容的封套序列化错误可使用该纠错预算。
UPSTREAM_ACTION_RETRIES=2
# 正文、思考、工具名称/ID/参数的累计 UTF-8 字节上限；每个未闭合 SSE 事件也独立受此限制。
MAX_ACTION_BYTES=1048576
